{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "movil-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd mobile && npx expo start --web --port 8081"],
      "port": 8081,
      "url": "http://localhost:8081"
    },
    {
      "name": "web-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--directory", "mobile/dist"],
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "web-nextjs",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "url": "http://localhost:3000"
    }
  ]
}
